#!/usr/bin/env python3
"""stratBot CLI — control the trading bot via signals and file flags."""

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
# Import shared runtime paths from util. Ensures CLI and bot agree on file
# locations even if STRATBOT_DIR ever moves (e.g., to XDG_RUNTIME_DIR).
sys.path.insert(0, str(PROJECT_ROOT))
from util import STRATBOT_DIR, PAUSE_FLAG, PID_FILE, STATUS_FILE, BOT_OUTPUT_FILE

BOT_SCRIPT = PROJECT_ROOT / "Main.py"
VENV_PYTHON = PROJECT_ROOT / "venv" / "bin" / "python"
CREDENTIALS_FILE = PROJECT_ROOT / "alpaca_config.py"
MIN_PYTHON = (3, 12)      # requirements.txt: "Python >= 3.12"
START_TIMEOUT_S = 15      # how long `start` waits for Main.py to write its PID file
START_GRACE_S = 3         # after the PID file appears, keep watching this long for an early exit
VENV_HINT = (
    "Create the project venv with:\n"
    "    uv venv venv -p 3.13 && uv pip install -p venv/bin/python -r requirements.txt\n"
    "or: python3.13 -m venv venv && venv/bin/pip install -r requirements.txt"
)


def _python_version(python):
    """Return (major, minor) of the given interpreter, or None if it can't be run."""
    try:
        result = subprocess.run(
            [python, "-c", "import sys; print(sys.version_info[0], sys.version_info[1])"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0:
            major, minor = result.stdout.split()
            return int(major), int(minor)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return None


def _resolve_python():
    """Pick the interpreter for Main.py; refuse anything older than MIN_PYTHON.

    Prefers venv/bin/python. Falls back to the interpreter running this CLI
    (usually the system python3) only if it is new enough — otherwise the bot
    would die on import and, before this check, the CLI would still report
    "started".
    """
    if VENV_PYTHON.exists():
        python, label = str(VENV_PYTHON), "venv/bin/python"
    else:
        python, label = sys.executable, sys.executable
        print(f"Warning: {PROJECT_ROOT / 'venv'} not found; trying {sys.executable}",
              file=sys.stderr)

    version = _python_version(python)
    if version is None:
        print(f"Error: cannot run {label}", file=sys.stderr)
        print(VENV_HINT, file=sys.stderr)
        return None
    if version < MIN_PYTHON:
        print(f"Error: {label} is Python {version[0]}.{version[1]}; "
              f"stratBot needs >= {MIN_PYTHON[0]}.{MIN_PYTHON[1]}.", file=sys.stderr)
        print(VENV_HINT, file=sys.stderr)
        return None
    return python


def _tail(path, n=20):
    """Last n lines of a text file (empty list if unreadable)."""
    try:
        return path.read_text(errors="replace").splitlines()[-n:]
    except OSError:
        return []


def _read_pid():
    """Read and validate the PID file. Falls back to pgrep if PID file is missing."""
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, 0)  # check if process exists
            return pid
        except (ProcessLookupError, ValueError):
            # Stale PID — process no longer running
            PID_FILE.unlink(missing_ok=True)

    # Fallback: find orphaned bot process via pgrep. Match the absolute
    # BOT_SCRIPT path so we don't catch unrelated "Main.py" processes
    # (e.g., another checkout of this repo).
    try:
        result = subprocess.run(
            ["pgrep", "-f", str(BOT_SCRIPT)],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            pids = [int(p) for p in result.stdout.strip().split('\n') if p]
            # Filter out this script's own PID and parent
            own = {os.getpid(), os.getppid()}
            pids = [p for p in pids if p not in own]
            if len(pids) > 1:
                # Refuse to guess which one is "the" bot.
                print(
                    f"Warning: multiple bot processes found ({pids}); "
                    f"refusing to guess. Kill manually or remove {PID_FILE}.",
                    file=sys.stderr,
                )
                return None
            if pids:
                pid = pids[0]
                try:
                    os.kill(pid, 0)  # verify alive
                except ProcessLookupError:
                    return None
                # Restore the PID file
                PID_FILE.parent.mkdir(parents=True, exist_ok=True)
                PID_FILE.write_text(str(pid))
                return pid
    except Exception:
        pass

    return None


def cmd_start(args):
    pid = _read_pid()
    if pid:
        print(f"stratbot already running (PID {pid})")
        return 1

    # Pre-flight: fail fast with a useful message instead of letting Main.py
    # die silently on import.
    if not CREDENTIALS_FILE.exists():
        print(f"Error: {CREDENTIALS_FILE} not found.", file=sys.stderr)
        print("Create it with your Alpaca credentials (it is gitignored):\n"
              "    alpaca_config = {'key': 'PK...', 'secret_key': '...'}",
              file=sys.stderr)
        return 1
    python = _resolve_python()
    if python is None:
        return 1

    cmd = [python, str(BOT_SCRIPT)]
    if args.fresh:
        cmd.append("--fresh")

    # Bot output goes to a file (not DEVNULL) so a crash is diagnosable.
    STRATBOT_DIR.mkdir(parents=True, exist_ok=True)
    with open(BOT_OUTPUT_FILE, "a") as out:
        out.write(f"\n===== stratbot start {time.strftime('%Y-%m-%d %H:%M:%S')} "
                  f"| {' '.join(cmd)} =====\n")
        out.flush()
        proc = subprocess.Popen(
            cmd,
            cwd=str(PROJECT_ROOT),   # Main.py reads config.toml relative to cwd
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=out,
            stderr=subprocess.STDOUT,
        )

    # Wait until the bot either writes its PID file (healthy) or exits (failed).
    # Once the PID file appears, keep watching for START_GRACE_S more seconds:
    # an init failure right after the PID write would otherwise still look
    # like a successful start.
    deadline = time.time() + START_TIMEOUT_S
    pid_seen_at = None
    while True:
        rc = proc.poll()
        if rc is not None:
            print(f"stratbot failed to start (exit code {rc}). "
                  f"Last output from {BOT_OUTPUT_FILE}:", file=sys.stderr)
            for line in _tail(BOT_OUTPUT_FILE):
                print("  " + line, file=sys.stderr)
            return 1
        now = time.time()
        if pid_seen_at is None and PID_FILE.exists():
            try:
                if int(PID_FILE.read_text().strip()) == proc.pid:
                    pid_seen_at = now
            except ValueError:
                pass  # partially written; retry
        if pid_seen_at is not None and now - pid_seen_at >= START_GRACE_S:
            print(f"stratbot started (PID {proc.pid})")
            print(f"Bot output:    {BOT_OUTPUT_FILE}")
            print("Check status:  stratbot status")
            print("Graceful stop: stratbot stop")
            return 0
        if pid_seen_at is None and now >= deadline:
            break
        time.sleep(0.25)

    print(f"stratbot launched (PID {proc.pid}) but has not written {PID_FILE} "
          f"after {START_TIMEOUT_S}s — it may still be importing.")
    print(f"Check:  stratbot status   |   tail -f {BOT_OUTPUT_FILE}")
    return 0


def cmd_stop(args):
    pid = _read_pid()
    if not pid:
        print("stratbot is not running")
        return 0

    os.kill(pid, signal.SIGTERM)
    print(f"Sent SIGTERM to PID {pid}, waiting for graceful exit...")

    for _ in range(30):
        time.sleep(1)
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            STATUS_FILE.unlink(missing_ok=True)
            PAUSE_FLAG.unlink(missing_ok=True)
            print("stratbot stopped.")
            return 0

    print("Still running after 30s. Use 'stratbot kill' to force.")
    return 1


def cmd_kill(args):
    pid = _read_pid()
    if not pid:
        print("stratbot is not running")
        return 0

    # First try SIGUSR1 (force-close positions gracefully)
    os.kill(pid, signal.SIGUSR1)
    print(f"Sent SIGUSR1 to PID {pid}, waiting...")

    for _ in range(10):
        time.sleep(1)
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            print("stratbot terminated. Close signals sent; broker-side closure not verified.")
            return 0

    # Escalate to SIGKILL
    print("Still running — sending SIGKILL...")
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    PID_FILE.unlink(missing_ok=True)
    STATUS_FILE.unlink(missing_ok=True)
    PAUSE_FLAG.unlink(missing_ok=True)
    print("stratbot force-killed.")
    return 0


def cmd_status(args):
    pid = _read_pid()

    if not STATUS_FILE.exists():
        if pid:
            print(f"stratbot running (PID {pid}) but no status file yet")
        else:
            print("stratbot is not running")
        return 0

    # Cross-check: status file exists but no live process → stale data
    if not pid:
        STATUS_FILE.unlink(missing_ok=True)
        print("stratbot is not running")
        return 0

    status = json.loads(STATUS_FILE.read_text())
    age = time.time() - status.get("timestamp", 0)

    if age > 15:
        print(f"WARNING: status is {age:.0f}s stale — bot may be unresponsive\n")

    uptime = status.get("uptime_seconds", 0)
    h, m = uptime // 3600, (uptime % 3600) // 60
    print(f"  State     : {status.get('state', '?')}")
    print(f"  Uptime    : {h}h {m}m")
    print(f"  Market    : {'OPEN' if status.get('market_open') else 'CLOSED'}")
    print(f"  Tickers   : {status.get('tickers_active', '?')}")
    print(f"  Open      : {status.get('trades_open', 0)} trade(s)")
    print(f"  Closed    : {status.get('trades_closed_today', 0)} today")
    print(f"  P&L       : ${status.get('realized_pnl', 0):.2f}")

    positions = status.get("open_positions", [])
    if positions:
        print(f"\n  Open positions:")
        for p in positions:
            print(
                f"    {p['symbol']:6s}  {p['direction']:5s}  "
                f"entry ${p['entry']:.2f}  day {p['days_open']}  "
                f"{p.get('strategy', '')}"
            )
    return 0


def cmd_pause(args):
    pid = _read_pid()
    if not pid:
        print("stratbot is not running")
        return 1

    if PAUSE_FLAG.exists():
        print("Already paused")
        return 0

    PAUSE_FLAG.parent.mkdir(parents=True, exist_ok=True)
    PAUSE_FLAG.touch()
    print("Paused — no new entries. Open trades still managed.")
    return 0


def cmd_resume(args):
    if not PAUSE_FLAG.exists():
        print("Not paused")
        return 0

    PAUSE_FLAG.unlink()
    print("Resumed — new entries enabled.")
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="stratbot",
        description="Control the stratBot trading bot",
    )
    subs = parser.add_subparsers(dest="command")

    p_start = subs.add_parser("start", help="Start the bot in background")
    p_start.add_argument("--fresh", action="store_true", help="Ignore saved state")

    subs.add_parser("stop", help="Graceful exit — save state, keep positions")
    subs.add_parser("kill", help="Force-close all positions and exit")
    subs.add_parser("status", help="Show bot status and open positions")
    subs.add_parser("pause", help="Stop new entries, keep managing open trades")
    subs.add_parser("resume", help="Resume new entries after pause")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0

    handler = {
        "start": cmd_start,
        "stop": cmd_stop,
        "kill": cmd_kill,
        "status": cmd_status,
        "pause": cmd_pause,
        "resume": cmd_resume,
    }[args.command]

    return handler(args)


if __name__ == "__main__":
    sys.exit(main() or 0)
